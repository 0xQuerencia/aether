#!/usr/bin/env python3
"""Fetch and cache timestamped LRC lyrics for Aether. No background requests."""
import argparse
from email.utils import parsedate_to_datetime
import secrets
import hashlib
import json
import os
from pathlib import Path
import re
import time
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

CACHE = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "aether" / "lyrics"
LOCAL = Path.home() / "Music" / "lyrics"
TIME_TAG = re.compile(r"\[(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?\]")
MAX_TEXT = 180000
TTL = 30 * 86400
MISS_TTL = 3600


def cooldown_until():
    try:
        return float((CACHE / ".retry-after").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 0.0


def retry_seconds(header):
    try:
        return max(1, min(3600, int(header)))
    except (ValueError, TypeError):
        try:
            return max(1, min(3600, int(parsedate_to_datetime(header).timestamp() - time.time())))
        except (ValueError, TypeError, OverflowError):
            return 60


def save_cooldown(seconds):
    try:
        CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
        temp = CACHE / ("." + secrets.token_hex(12))
        temp.write_text(str(time.time() + seconds), encoding="utf-8")
        temp.chmod(0o600)
        temp.replace(CACHE / ".retry-after")
    except OSError:
        pass


def parse_lrc(raw):
    """Return sorted lyric lines with numeric timestamps in seconds."""
    if not isinstance(raw, str):
        return []
    lines = []
    for line in raw[:MAX_TEXT].splitlines():
        tags = list(TIME_TAG.finditer(line))
        if not tags:
            continue
        text = TIME_TAG.sub("", line).strip()
        if not text:
            continue
        for tag in tags:
            fraction = tag.group(3) or "0"
            at = int(tag.group(1)) * 60 + int(tag.group(2)) + int(fraction) / (10 ** len(fraction))
            if 0 <= at < 86400:
                lines.append({"time": round(at, 3), "text": text[:600]})
    return sorted(lines, key=lambda line: line["time"])


def local_file(title, artist):
    def safe(value):
        return re.sub(r"[^\w .()\[\]-]", "_", value, flags=re.UNICODE)[:90].strip(". ")
    name = safe(artist) + " - " + safe(title) + ".lrc"
    file = LOCAL / name
    if file.is_file():
        return file.read_text(encoding="utf-8", errors="replace")[:MAX_TEXT]
    return None


def lyrics(title, artist, duration, offline=False):
    title = title.strip()[:200]
    artist = artist.strip()[:200]
    if not title or not artist or title == "Not Playing":
        return {"status": "idle", "lines": []}
    duration = max(0, min(3600, int(duration)))
    key = hashlib.sha256(json.dumps([title.casefold(), artist.casefold(), duration]).encode()).hexdigest()
    destination = CACHE / (key + ".json")
    local = local_file(title, artist)
    if local is not None:
        return {"status": "local", "lines": parse_lrc(local)}
    if destination.is_file():
        try:
            value = json.loads(destination.read_text(encoding="utf-8"))
            ttl = MISS_TTL if value.get("status") == "unavailable" else TTL
            if time.time() - destination.stat().st_mtime < ttl:
                return value
        except (OSError, ValueError):
            pass
    if offline:
        return {"status": "offline", "lines": []}
    if cooldown_until() > time.time():
        return {"status": "rate-limited", "lines": []}
    query = {"track_name": title, "artist_name": artist}
    if duration:
        query["duration"] = duration
    url = "https://lrclib.net/api/get?" + urlencode(query)
    request = Request(url, headers={"User-Agent": "AetherShell/0.2 (lyrics display; on demand)", "Accept": "application/json"})
    try:
        with urlopen(request, timeout=6) as response:
            if response.status != 200:
                return {"status": "offline", "lines": []}
            data = json.loads(response.read(MAX_TEXT + 1))
        raw = data.get("syncedLyrics") or ""
        lines = parse_lrc(raw)
        value = {"status": "synced" if lines else "unavailable", "lines": lines}
    except HTTPError as exc:
        if exc.code == 429:
            save_cooldown(retry_seconds(exc.headers.get("Retry-After") if exc.headers else None))
            return {"status": "rate-limited", "lines": []}
        if exc.code != 404:
            return {"status": "offline", "lines": []}
        value = {"status": "unavailable", "lines": []}
    except (OSError, URLError, TimeoutError, ValueError, TypeError):
        return {"status": "offline", "lines": []}
    temp = None
    try:
        CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
        temp = CACHE / ("." + secrets.token_hex(12))
        temp.write_text(json.dumps(value, ensure_ascii=False), encoding="utf-8")
        temp.chmod(0o600)
        temp.replace(destination)
    except OSError:
        # Cache failure must not hide successfully fetched lyrics.
        if temp is not None:
            try:
                temp.unlink(missing_ok=True)
            except OSError:
                pass
    return value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("title")
    parser.add_argument("artist")
    parser.add_argument("duration", nargs="?", type=float, default=0)
    parser.add_argument("--offline", action="store_true")
    args = parser.parse_args()
    print(json.dumps(lyrics(args.title, args.artist, args.duration, args.offline), ensure_ascii=False))


if __name__ == "__main__":
    main()
